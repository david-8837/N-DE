{
  "name": "node-grid-macro-1",
  "private": true,
  "version": "1.0.2",
  "description": "NØDE Grid Macro 1 Desktop Studio for Windows",
  "author": "NØDE",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "vite build && electron-builder --win zip dir",
    "build:win": "vite build && electron-builder --win zip dir --x64 --publish never",
    "build:win:nsis": "vite build && electron-builder --win nsis --x64 --publish never",
    "clean": "rm -rf dist dist_electron server.js",
    "lint": "tsc --noEmit",
    "check:firmware": "tsx scripts/check_firmware_and_keys.ts",
    "simulate:matrix": "tsx scripts/simulate_matrix.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:e2e": "tsc -p tsconfig.e2e.json"
  },
  "build": {
    "appId": "ai.node.gridmacro1",
    "productName": "NØDE Grid Macro 1 Studio",
    "copyright": "Copyright © 2026 NØDE",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NØDE Grid Macro 1"
    }
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
